rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // --- FONCTIONS DE BASE ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérification basée sur les Custom Claims (token role)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' || 
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'SUPER_ADMIN';
    }

    // --- RÈGLES PAR DOSSIER ---

    // 1. Profils (Photos d'utilisateurs avec structure par sous-dossier UID)
    match /profils/{userId}/{fileName} {
      allow read: if true;
      // Permet l'écriture/suppression si c'est l'admin ou si l'utilisateur possède le dossier
      allow write, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // 2. Propriétés (Images limitées à 10 Mo et Vidéos limitées à 50 Mo)
    match /proprietes/{bailleurId}/{propertyId}/{allPaths=**} {
      allow read: if true; 
      // Autorise si c'est un admin, si c'est le bailleur, OU si l'utilisateur est simplement authentifié
      allow write, delete: if isAdmin() || (
        isAuthenticated() && 
        (
          request.method == 'DELETE' || 
          (
            // Cas d'une image : max 10 Mo
            (
              request.resource.size < 10 * 1024 * 1024 &&
              request.resource.contentType.matches('image/.*')
            )
            ||
            // Cas d'une vidéo : max 50 Mo
            (
              request.resource.size < 50 * 1024 * 1024 &&
              request.resource.contentType.matches('video/.*')
            )
          )
        )
      );
    }

    // 3. Dossier utilisateur générique
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // 4. Paiements et Preuves (Dossiers critiques pour les transactions)
    match /{folder}/{userId}/{fileName} {
      allow read, write, delete: if folder in ['paiements', 'preuves'] && (
        isAdmin() || (
          isAuthenticated() && 
          request.auth.uid == userId &&
          (request.method == 'GET' || request.method == 'DELETE' || request.resource.contentType.matches('image/.*'))
        )
      );
    }

    // 5. Documents confidentiels (Identité)
    match /identite_verif/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write, delete: if (isAuthenticated() && request.auth.uid == userId) || isSuperAdmin();
    }

    // 6. Sécurité par défaut (Tout le reste)
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isSuperAdmin();
    }
  }
}